# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iiit_mess?schema=public"

# JWT Configuration
JWT_SECRET="replace-with-a-long-random-cryptographic-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Razorpay Test Mode Credentials (ONLY Key ID and Key Secret are required)
# Paste your rzp_test_... Key ID and Test Key Secret below (no real money is charged)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: Webhook secret is NOT needed for Test Mode checkout verification
RAZORPAY_WEBHOOK_SECRET=""

# Pre-seeded Mess Personnel Account
MESS_EMAIL="mess@iiit-bh.ac.in"
MESS_INITIAL_PASSWORD="mess1234"

# Application & CORS Configuration
PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
