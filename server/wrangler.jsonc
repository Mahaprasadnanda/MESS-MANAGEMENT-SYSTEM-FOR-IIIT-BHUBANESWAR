{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iiit-mess-backend",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "CLIENT_URL": "https://mess-management-system-for-iiit-bhubaneswar.pages.dev"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "bca1dc49cbfa49b589582aa4bd13cfb0"
    }
  ]
}
