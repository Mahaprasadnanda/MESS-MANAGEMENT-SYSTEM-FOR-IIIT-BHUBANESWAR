generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MESS
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum BookingType {
  WEEKLY
  SAME_DAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  studentId    String?  @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weeklyBookings  WeeklyBooking[]
  payments        Payment[]
  coupons         Coupon[]        @relation("StudentCoupons")
  redeemedCoupons Coupon[]        @relation("RedeemedByMess")
  updatedMenus    Menu[]          @relation("MenuUpdatedBy")

  @@index([role])
  @@index([studentId])
}

model Menu {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  mealType    MealType
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User?      @relation("MenuUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     MenuItem[]

  @@unique([date, mealType])
  @@index([date])
  @@index([date, mealType])
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  name      String
  category  String?
  isVeg     Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model WeeklyBooking {
  id             String        @id @default(cuid())
  bookingCode    String        @unique
  bookingType    BookingType   @default(WEEKLY)
  weeklySlotKey  String?       @unique
  sameDayDate    DateTime?     @db.Date
  studentId      String
  weekStartDate  DateTime      @db.Date
  weekEndDate    DateTime      @db.Date
  breakfastCount Int           @default(0)
  lunchCount     Int           @default(0)
  dinnerCount    Int           @default(0)
  totalMeals     Int
  totalAmount    Decimal       @db.Decimal(10, 2)
  bookingStatus  BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mealBookings MealBooking[]
  payments     Payment[]
  coupons      Coupon[]

  @@index([studentId])
  @@index([weekStartDate])
  @@index([bookingType, sameDayDate])
  @@index([bookingStatus, paymentStatus])
}

model MealBooking {
  id              String   @id @default(cuid())
  weeklyBookingId String
  mealDate        DateTime @db.Date
  mealType        MealType
  price           Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  weeklyBooking WeeklyBooking @relation(fields: [weeklyBookingId], references: [id], onDelete: Cascade)
  coupon        Coupon?

  @@unique([weeklyBookingId, mealDate, mealType])
  @@index([mealDate, mealType])
  @@index([weeklyBookingId])
}

model Payment {
  id                String        @id @default(cuid())
  weeklyBookingId   String
  studentId         String
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  provider          String        @default("RAZORPAY")
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  transactionId     String?       @unique
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  weeklyBooking WeeklyBooking @relation(fields: [weeklyBookingId], references: [id], onDelete: Cascade)
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([weeklyBookingId])
  @@index([status])
  @@index([paidAt])
}

model Coupon {
  id              String       @id @default(cuid())
  couponCode      String       @unique
  weeklyBookingId String
  mealBookingId   String       @unique
  studentId       String
  mealDate        DateTime     @db.Date
  mealType        MealType
  qrPayload       String
  status          CouponStatus @default(ACTIVE)
  redeemedAt      DateTime?
  redeemedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  weeklyBooking WeeklyBooking @relation(fields: [weeklyBookingId], references: [id], onDelete: Cascade)
  mealBooking   MealBooking   @relation(fields: [mealBookingId], references: [id], onDelete: Cascade)
  student       User          @relation("StudentCoupons", fields: [studentId], references: [id], onDelete: Cascade)
  redeemedBy    User?         @relation("RedeemedByMess", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([studentId, mealDate])
  @@index([mealDate, mealType, status])
  @@index([status])
}
